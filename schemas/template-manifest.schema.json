{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:accrete:schema:template-manifest:1",
  "title": "accrete-template.json",
  "description": "Explicit asset snapshot installed with accrete init --template DIRECTORY or project upgrade --from DIRECTORY. Bounds are numeric major.minor.patch; CLI maximum is exclusive. The Kernel also checks ownership, destinations, existing bytes, and symlinks.",
  "type": "object",
  "required": [
    "format",
    "asset_version",
    "requires",
    "files"
  ],
  "properties": {
    "format": {
      "const": 1
    },
    "asset_version": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "requires": {
      "type": "object",
      "required": [
        "cli_min",
        "cli_max_exclusive",
        "project_format"
      ],
      "properties": {
        "cli_min": {
          "$ref": "#/$defs/version"
        },
        "cli_max_exclusive": {
          "$ref": "#/$defs/version"
        },
        "project_format": {
          "const": 1
        }
      },
      "additionalProperties": true
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "destination"
        ],
        "properties": {
          "source": {
            "$ref": "#/$defs/relativePath"
          },
          "destination": {
            "$ref": "#/$defs/relativePath"
          },
          "executable": {
            "type": "boolean",
            "default": false
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*[\\\\:\\u0000-\\u001f])[^/]+(?:/[^/]+)*$",
      "description": "Portable relative file path; no empty, dot, parent, backslash, colon or control-character components. Protected project paths and overlapping destinations are rejected by the Kernel."
    }
  }
}
